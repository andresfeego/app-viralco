{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --no-packager",
    "ios:run": "react-native run-ios --no-packager",
    "ios:metro": "react-native start --host 127.0.0.1 --port 8081",
    "ios:logs": "xcrun simctl spawn booted log stream --level debug --style compact --predicate 'process == \"mobile\" OR process == \"mobile.debug.dylib\" OR eventMessage CONTAINS[c] \"No script URL\" OR eventMessage CONTAINS[c] \"RCTFatal\" OR eventMessage CONTAINS[c] \"Unable to load script\"'",
    "ios:screenshot": "bash ./scripts/ios_screenshot.sh",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-vector-icons/fontawesome6": "^13.1.1",
    "@react-native/new-app-screen": "0.85.2",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-video": "^6.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
