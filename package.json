{
  "name": "kaptura",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --terminal \"Terminal\"",
    "ios:run": "react-native run-ios --terminal \"Terminal\"",
    "ios:run:no-packager": "react-native run-ios --no-packager",
    "ios:metro": "react-native start --host 0.0.0.0 --port 8081",
    "ios:logs": "xcrun simctl spawn booted log stream --level debug --style compact --predicate 'process == \"kaptura\" OR process == \"kaptura.debug.dylib\" OR eventMessage CONTAINS[c] \"No script URL\" OR eventMessage CONTAINS[c] \"RCTFatal\" OR eventMessage CONTAINS[c] \"Unable to load script\"'",
    "ios:screenshot": "bash ./scripts/ios_screenshot.sh",
    "lint": "eslint .",
    "start": "react-native start --host 0.0.0.0",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native-vector-icons/fontawesome6": "^13.1.1",
    "@react-native/new-app-screen": "0.85.2",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-toast-message": "^2.4.0",
    "react-native-video": "6.19.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
